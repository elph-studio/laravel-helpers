{
    "name": "elph-studio/laravel-helpers",
    "type": "library",
    "description": "Laravel helpers and core functionality updates",
    "license": "MIT",
    "keywords": ["laravel", "helpers"],
    "authors": [{
        "name": "Elephant Studio",
        "email": "developers@elph.studio",
        "homepage": "https://www.elph.studio"
    }],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "elph-studio/laravel-testing-tools": "^0.3",
        "laravel/framework": "12.*"
    },
    "autoload": {
        "psr-4": {
            "Elph\\LaravelHelpers\\": "src"
        },
        "files": [
            "src/Helper/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php src/Helper/Plain/VendorFixer.php"
        ],
        "post-update-cmd": [
            "@php src/Helper/Plain/VendorFixer.php"
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
